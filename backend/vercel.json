{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install --workspaces=false",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/cron/agenda-cleanup",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/mercado-livre-store-sync",
      "schedule": "*/30 * * * *"
    }
  ]
}
